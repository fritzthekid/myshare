# Copy to /etc/myshare/backend.env (chmod 600, root:root).
# Read by the wrapper script /usr/lib/cups/backend/nextcloud before
# invoking the actual backend, since CUPS starts backends with a minimal
# environment.

NC_BASE_URL=https://cloud.example.com
NC_USERNAME=change-cloud-user
NC_PASSWORD=changeme-app-password
#NC_TARGET_DIR=/PrinterUploads
#NC_LINK_EXPIRE_DAYS=1
# Length of the code derived via "nc-password-seed=<name>" (see
# scripts/share-to-web.sh, internal/sharepassword) - default 15, divisible
# by 5 for three equally sized, hyphen-separated groups of five in the
# display (e.g. "SJBB3-ZMD7P-R4HIQ").
#NC_LEN_CODE=15

# "tmp" (default) is relative to the backend process's working directory -
# under CUPS that's not the project directory. Set this to an absolute
# path for production use (created by the install.sh script):
MYSHARE_OUTPUT_DIR=/var/lib/myshare/tmp

# Optional output hook: called after every success as
# "<hook> <qr-png> <link>", e.g. to display the QR code on an attached
# display (see raspi/). A failure doesn't make the print job fail.
#MYSHARE_DISPLAY_HOOK=/usr/local/lib/myshare/toraspi.sh
#RASPI_HOST=raspi.local
#RASPI_DISPLAY_TIMEOUT=10
# Alternative to the Pi display: use cloudweb (see below) instead of toraspi.sh:
#MYSHARE_DISPLAY_HOOK=/usr/local/lib/myshare/push-to-cloudweb.sh
#CLOUDWEB_URL=http://127.0.0.1:40080
#CLOUDWEB_PASSWORD=

# webshare (phone/browser upload without its own Nextcloud credentials):
# access is secured exclusively via this secret token in the URL
# (/s/<token>/), no login. install.sh generates it automatically if none is
# set here yet. WEBSHARE_LISTEN optional, default ":8642".
#WEBSHARE_TOKEN=
#WEBSHARE_LISTEN=:8642

# cloudweb (QR display in the browser instead of the Pi display, see
# cmd/cloudweb): the server's own listen address, default ":40080".
#CLOUDWEB_LISTEN=:40080
