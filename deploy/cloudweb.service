[Unit]
Description=myshare QR display (cloudweb)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/myshare/backend.env
ExecStart=/usr/local/lib/myshare/cloudweb
Restart=on-failure
# Unlike backend/webshare, needs no special privileges (no file access, no
# Nextcloud credentials needed) - therefore runs with an unprivileged,
# disposable user generated by systemd instead of as root.
DynamicUser=yes

[Install]
WantedBy=multi-user.target
