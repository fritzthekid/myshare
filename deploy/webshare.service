[Unit]
Description=myshare web upload (phone/browser -> Nextcloud + QR)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/myshare/backend.env
ExecStart=/usr/local/lib/myshare/webshare
Restart=on-failure
# Runs as root so it can (like the CUPS backend) write to MYSHARE_OUTPUT_DIR
# and call the display hook without special-privilege fiddling - same
# trust level as the CUPS backend process already running as root on this
# machine.
User=root

[Install]
WantedBy=multi-user.target
