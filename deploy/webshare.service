[Unit]
Description=myshare Web-Upload (Handy/Browser -> Nextcloud + QR)
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/myshare/backend.env
ExecStart=/usr/local/lib/myshare/webshare
Restart=on-failure
# Läuft als root, damit es (wie das CUPS-Backend) ohne Sonderrechte-Gefummel
# nach MYSHARE_OUTPUT_DIR schreiben und den Anzeige-Hook aufrufen kann
# - gleiche Vertrauensebene wie der bereits als root laufende CUPS-Backend-
# Prozess auf dieser Maschine.
User=root

[Install]
WantedBy=multi-user.target
