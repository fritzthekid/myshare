# Copy to C:\ProgramData\myshare\backend.env - read automatically on
# startup by cloudweb.exe (service "CloudWeb", see internal/envfile),
# analogous to EnvironmentFile= under systemd (Linux).

NC_BASE_URL=https://cloud.example.com
NC_USERNAME=change-cloud-user
NC_PASSWORD=changeme-app-password
#NC_TARGET_DIR=/PrinterUploads
#NC_LINK_EXPIRE_DAYS=1
# Length of the code derived by fileshare.exe (password protection with an
# optional name) - default 15, divisible by 5 for three equally sized,
# hyphen-separated groups of five in the display.
#NC_LEN_CODE=15

# Display server (see cmd/cloudweb): listen address, default ":40080".
#CLOUDWEB_LISTEN=:40080

# Used by fileshare.exe (Explorer "Send to") to hand the result to the
# locally running "CloudWeb" service - default "http://127.0.0.1:40080"
# matches CLOUDWEB_LISTEN above and usually doesn't need to be changed.
#CLOUDWEB_URL=http://127.0.0.1:40080
