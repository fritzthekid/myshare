[Unit]
Description=Shows images delivered via scp on the framebuffer for a limited time
After=multi-user.target

[Service]
Type=simple
User=root
# Deliberately not tied to any one user's $HOME (the service runs as
# root, but files are delivered by whichever user scp's them in) -
# override here if you'd rather use a different path.
Environment=WATCH_DIR=/tmp/fb-image-watcher/fb-drop
# Which fb number the SPI TFT gets can vary - if nothing shows up, check
# with `dmesg | grep -i fb_ili9486` on this Pi instead of assuming
# /dev/fb1.
Environment=FB_DEVICE=/dev/fb1
Environment=TIMEOUT=10
ExecStart=/usr/local/bin/fb-image-watcher.sh
Restart=on-failure
StandardOutput=append:/var/log/fb-image-watcher.log
StandardError=append:/var/log/fb-image-watcher.log

[Install]
WantedBy=multi-user.target
