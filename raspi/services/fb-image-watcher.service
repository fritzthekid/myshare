[Unit]
Description=Shows images delivered via scp on the framebuffer for a limited time
After=multi-user.target

[Service]
Type=simple
User=root
# WATCH_DIR must point to the home directory of the user the images are
# delivered to via scp (service runs as root, $HOME would otherwise be
# /root) - adjust before installing.
Environment=WATCH_DIR=/home/CHANGE_ME/fb-drop
# Which fb number the SPI TFT gets depends on probe order - check with
# `dmesg | grep -i fb_ili9486` on this Pi before installing, it may not
# be /dev/fb0.
Environment=FB_DEVICE=/dev/fb0
Environment=TIMEOUT=10
ExecStart=/usr/local/bin/fb-image-watcher.sh
Restart=on-failure
StandardOutput=append:/var/log/fb-image-watcher.log
StandardError=append:/var/log/fb-image-watcher.log

[Install]
WantedBy=multi-user.target
